# Production Environment Configuration
NODE_ENV=production
PORT=8081
HOST=0.0.0.0

# Database Configuration (Use external managed database in production)
DATABASE_URL="postgresql://prod_user:CHANGE_THIS_PASSWORD@db.example.com:5432/video_conference_prod"
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=video_conference_prod
DB_USER=prod_user
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_SSLMODE=require
DB_MAX_CONNECTIONS=50
DB_MAX_IDLE_CONNECTIONS=20
DB_MAX_LIFETIME_MINUTES=30

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=CHANGE_THIS_SUPER_SECRET_JWT_KEY_IN_PRODUCTION_123456789
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=CHANGE_THIS_SUPER_SECRET_REFRESH_KEY_IN_PRODUCTION_123456789
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com

# WebRTC Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVERS=turn:your-turn-server.com:3478

# Email Configuration (Production SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# Redis Configuration (Use external managed Redis in production)
REDIS_URL=redis://redis.example.com:6379
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# Logging
LOG_LEVEL=warn
LOG_FORMAT=combined

# Rate Limiting (More restrictive in production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# File Storage (Use cloud storage in production)
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=100mb
AWS_S3_BUCKET=your-video-conference-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Security
BCRYPT_ROUNDS=12
COOKIE_SECRET=CHANGE_THIS_SUPER_SECRET_COOKIE_KEY_IN_PRODUCTION_123456789
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# Google Calendar Integration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# SSL/TLS
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key

# Health Checks
HEALTH_CHECK_TIMEOUT=10000
HEALTH_CHECK_INTERVAL=30000