# Development Environment Configuration
NODE_ENV=development
PORT=8081
HOST=0.0.0.0

# Database Configuration
DATABASE_URL="postgresql://postgres:dev_password@postgres:5432/video_conference_dev"
DB_HOST=postgres
DB_PORT=5432
DB_NAME=video_conference_dev
DB_USER=postgres
DB_PASSWORD=dev_password
DB_SSLMODE=prefer
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_LIFETIME_MINUTES=60

# JWT Configuration
JWT_SECRET=dev-jwt-secret-key-12345678901234567890
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=dev-refresh-secret-key-12345678901234567890
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# WebRTC Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVERS=

# Email Configuration (Development)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev
SMTP_PASS=dev
SMTP_FROM=noreply@dev.videoconf.local

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=50mb

# Security
BCRYPT_ROUNDS=10
COOKIE_SECRET=dev-cookie-secret-12345678901234567890

# Google Calendar (Optional - for development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090