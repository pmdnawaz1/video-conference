# Backend Environment Variables for Enterprise Video Conference Platform

# Server Configuration
PORT=8081
ENV=development
DEBUG=true

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=video_conference
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_LIFETIME_MINUTES=60

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-32-chars-min
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7
PASSWORD_RESET_EXPIRY_HOURS=1
BCRYPT_COST=12
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# WebRTC Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Email Configuration (SMTP)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=your-email@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=Video Conference Platform
SMTP_FROM_EMAIL=noreply@yourdomain.com

# File Upload & Storage
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
STORAGE_TYPE=local
STORAGE_PATH=./uploads
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Recording Configuration
RECORDING_ENABLED=true
RECORDING_MAX_DURATION_HOURS=4
RECORDING_STORAGE_PATH=./recordings
RECORDING_AUTO_DELETE_DAYS=30

# Redis Configuration (for session management and caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3

# Monitoring & Logging
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
HEALTH_CHECK_ENDPOINT=/health

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=50

# Core Platform Features
FEATURE_SCREEN_SHARING=true
FEATURE_RECORDING=true
FEATURE_CHAT=true
FEATURE_WAITING_ROOM=true
FEATURE_RAISE_HAND=true

# Development Only
DEV_AUTO_MIGRATE=true
DEV_SEED_DATA=true